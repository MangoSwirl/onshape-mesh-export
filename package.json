{
  "name": "onshape-mesh-export",
  "version": "0.2.0",
  "description": "Userscript that saves the mesh the Onshape web client received, per part, from Part Studios and Assemblies as STL, OBJ or raw JSON",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "DOWNLOAD_URL=${DOWNLOAD_URL:-https://raw.githubusercontent.com/MangoSwirl/onshape-mesh-export/main/dist/onshape-mesh-export.user.js} node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "check": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MangoSwirl/onshape-mesh-export"
  }
}
